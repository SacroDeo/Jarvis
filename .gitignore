# ── Build outputs ─────────────────────────────────────────────────────────────
*.apk
*.aab
*.dex
build/
.gradle/

# ── Local machine configuration — NEVER commit ────────────────────────────────
local.properties
keys.properties
secrets.properties

# ── Android signing keys — NEVER commit ───────────────────────────────────────
*.keystore
*.jks

# ── JVM crash / Kotlin compiler replay logs ───────────────────────────────────
# These are generated by OOM build failures and contain no useful tracked data.
hs_err_pid*.log
replay_pid*.log

# ── IDE files ─────────────────────────────────────────────────────────────────
.idea/
*.iml

# ── OS generated files ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# ── Prebuilt APK distribution ─────────────────────────────────────────────────
# GitHub Actions produces the installable APK; no need to track a binary here.
dist/

# ── Cloudflare Worker (jarvis-worker/) ────────────────────────────────────────
# .dev.vars is already excluded by jarvis-worker/.gitignore; repeated here as
# belt-and-suspenders to prevent accidental credential exposure.
jarvis-worker/.dev.vars
jarvis-worker/.wrangler/
node_modules/

# ── Multi-model review artifacts ──────────────────────────────────────────────
.aidelegate/
