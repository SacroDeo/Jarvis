<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lazy-requested at runtime for local contact lookup (call_contact tool only). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Lazy-requested at runtime: required to place a call directly via ACTION_CALL.
         Declaring it here satisfies the PackageManager check; the runtime grant is
         requested through the normal ActivityResultContracts.RequestPermission flow
         in ConversationScreen when the user issues an explicit call command. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Normal-level permission required by AlarmClock.ACTION_SET_ALARM on older APIs.
         Automatically granted by the system; no runtime dialog needed. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Lets the wake-word service launch the app from the background (BAL exemption). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Always-on wake word: restart on boot + stay alive under battery optimization. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        On Android 11+ (targetSdk 30+) the system filters PackageManager results by default.
        Declaring the MAIN+LAUNCHER intent in <queries> ensures queryIntentActivities()
        returns the full list of installed launchable apps regardless of OEM customisations
        (e.g. Realme ColorOS).  Without this, AppLaunchTool.queryLaunchableApps() can
        return an empty list, making every "open X" request fail silently.

        The ACTION_VIEW/https intent entry lets DeepLinkTool resolve which apps can handle
        HTTPS URLs (browsers, YouTube, etc.) on Android 11+.  The explicit package entries
        for YouTube and Spotify are required so that setPackage() calls in DeepLinkTool work
        even when those apps are not the default handler for the https scheme.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- DeepLinkTool: resolve browser and app handlers for HTTPS URLs -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- DeepLinkTool: YouTube app direct launch via setPackage() -->
        <package android:name="com.google.android.youtube" />
        <!-- DeepLinkTool: Spotify app deep link via setPackage() -->
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jarvis"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Jarvis">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Digital assistant integration -->
        <service
            android:name=".assist.JarvisInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".assist.JarvisInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- "Hey Jarvis" always-on wake word -->
        <service
            android:name=".wake.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".wake.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".assist.JarvisRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

    </application>

</manifest>
